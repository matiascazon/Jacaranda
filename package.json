{
  "name": "jacaranda",
  "version": "0.1.0",
  "description": "Bootstrapper portable para construir y mantener un entorno personal de agentes de codigo (OpenCode, Pi, OpenSpec, Engram, Skills, MCP).",
  "type": "module",
  "bin": {
    "jacaranda": "./dist/src/cli.js"
  },
  "files": [
    "dist",
    "skills"
  ],
