  },
  "keywords": [
    "agent",
    "agents",
    "opencode",
    "pi",
    "openspec",
    "engram",
    "skills",
    "mcp",
    "bootstrap",
    "cli"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}